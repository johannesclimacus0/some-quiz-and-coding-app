{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write resources/js",
        "format:check": "prettier --check resources/js",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/echo-vue": "^2.5.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "concurrently": "^10.0.3",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "laravel-echo": "^2.5.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "3.9.7",
        "pusher-js": "^8.6.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1"
    }
}
